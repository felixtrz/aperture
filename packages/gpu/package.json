{
  "name": "@aperture-engine/gpu",
  "version": "0.3.0",
  "description": "Shared WebGPU graph execution, resources and standalone shader programs for Aperture.",
  "author": "Felix Zhang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felixtrz/aperture.git",
    "directory": "packages/gpu"
  },
  "homepage": "https://github.com/felixtrz/aperture/tree/main/packages/gpu#readme",
  "bugs": "https://github.com/felixtrz/aperture/issues",
  "keywords": [
    "aperture",
    "webgpu",
    "wgsl",
    "shader",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": "^22.18.0 || >=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./internal/*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aperture-engine/shader": "workspace:^",
    "@webgpu/types": "0.1.72"
  }
}
