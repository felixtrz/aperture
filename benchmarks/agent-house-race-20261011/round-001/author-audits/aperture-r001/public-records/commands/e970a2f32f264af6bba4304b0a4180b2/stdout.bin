      .list()
      .find((candidate) => candidate.id === id);

    if (id === undefined || handle === undefined || handle.kind !== "gltf") {
      return {
        ok: false,
        diagnostics: [
          {
            code: "aperture.assetInspect.gltfAssetNotFound",
            message:
              "asset_inspect requires the id of a configured glTF asset.",
          },
        ],
      };
    }
